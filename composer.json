{
    "name": "nlp/nlp-silverstripe",
    "type": "silverstripe-recipe",
    "description": "The SilverStripe Framework Installer",
    "require": {
        "php": "^8.5",
        "silverstripe/recipe-plugin": "^2",
        "silverstripe/recipe-cms": "^6.2",
        "dnadesign/silverstripe-elemental": "^6.2",
        "ext-json": "*",
        "colymba/gridfield-bulk-editing-tools": "^5",
        "undefinedoffset/sortablegridfield": "^3",
        "jonom/focuspoint": "^6",
        "tractorcow/silverstripe-fluent": "^8",
        "silverstripe/login-forms": "^6",
        "silverstripe/blog": "^5",
        "dnadesign/silverstripe-elemental-userforms": "^5",
        "purplespider/silverstripe-basic-gallery-extension": "^5",
        "silverstripe/linkfield": "^5.2",
        "dompdf/dompdf": "^3",
        "wilr/silverstripe-googlesitemaps": "^4",
        "stevenpaw/silverstripe-cms-backend-theme": "^1.1",
        "atwx/silverstripe-vitehelper": "^1.3"
    },
    "require-dev": {
        "silverleague/ideannotator": "^4",
        "squizlabs/php_codesniffer": "^3.6",
        "wernerkrauss/silverstripe-rector": "^1",
        "cambis/silverstan": "^2",
        "phpstan/extension-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/"
        }
    },
    "extra": {
        "expose": [
            "app/client/dist",
            "app/client/icons",
            "app/client/src/images"
        ],
        "resources-dir": "_resources",
        "project-files-installed": [
            "app/.htaccess",
            "app/_config.php",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "scripts": {
        "lint": "vendor/bin/phpcs",
        "fix": "vendor/bin/phpcbf",
        "rector": "vendor/bin/rector -v",
        "rector-dry": "vendor/bin/rector -v --dry-run",
        "phpstan": "vendor/bin/phpstan"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
